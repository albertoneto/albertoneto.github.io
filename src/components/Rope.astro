---
interface Props { hint: string }
const { hint } = Astro.props;
---
<div class="sim">
  <canvas id="rope" aria-hidden="true"></canvas>
  <div class="hud" aria-hidden="true">
    <span>PendulumSolver.Step</span>
    <span>nodes <b>24</b> · iter <b>12</b></span>
    <span>|v| <b id="hud-v">0.0</b> u/s</span>
    <span>stretch <b id="hud-s">0.00</b></span>
  </div>
  <p class="sim-hint" aria-hidden="true">↖ {hint}</p>
</div>

<style>
  .sim { position: absolute; inset: 0; }
  #rope { position: absolute; inset: 0; width: 100%; height: 100%; cursor: grab; touch-action: none; }
  #rope.dragging { cursor: grabbing; }
  .hud { position: absolute; top: 10px; left: 10px; display: grid; gap: 3px; font: 400 11px/1.3 var(--mono); color: var(--muted); pointer-events: none; }
  .hud span:first-child { color: var(--gizmo); font-weight: 600; }
  .hud b { color: var(--ink); font-weight: 500; }
  .sim-hint { position: absolute; right: 12px; bottom: 10px; margin: 0; font: 500 11px/1 var(--mono); color: var(--red); text-transform: uppercase; letter-spacing: .1em; pointer-events: none; transition: opacity .4s; }
  .sim.used .sim-hint { opacity: 0; }
</style>

<script>
  // Corda verlet de uma via (só puxa) com o gancho na ponta. Desenhada como gizmo de debug:
  // nós, restrições, vetor de velocidade. Arrasta o gancho; solto, ele balança.
  const canvas = document.getElementById('rope') as HTMLCanvasElement;
  const sim = canvas.parentElement!;
  const ctx = canvas.getContext('2d')!;
  const vOut = document.getElementById('hud-v')!;
  const sOut = document.getElementById('hud-s')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const N = 24, ITER = 12;
  type P = { x: number; y: number; px: number; py: number };
  let W = 0, H = 0, seg = 10, pts: P[] = [], anchor = { x: 0, y: 0 };
  let drag = false, mx = 0, my = 0, visible = true, frame = 0;

  function css(name: string) { return getComputedStyle(document.documentElement).getPropertyValue(name).trim(); }
  const col = { ink: css('--ink') || '#151412', red: css('--red') || '#ff3d17', giz: css('--gizmo') || '#1fae6c', muted: css('--muted') || '#7b756b' };

  function resize() {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const r = canvas.getBoundingClientRect();
    W = r.width; H = r.height;
    canvas.width = W * dpr; canvas.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    anchor = { x: W * 0.5, y: Math.max(96, H * 0.18) };
    // comprimento cabe no balanço dentro da caixa, nos dois eixos
    seg = Math.min(H * 0.66, W * 0.44) / (N - 1);
    if (!pts.length) {
      // começa erguida a ~60°: o primeiro balanço é a apresentação
      const a = Math.PI / 3;
      pts = Array.from({ length: N }, (_, i) => {
        const x = anchor.x + Math.sin(a) * i * seg, y = anchor.y + Math.cos(a) * i * seg;
        return { x, y, px: x, py: y };
      });
    }
  }

  function step() {
    for (let i = 1; i < N; i++) {
      const p = pts[i];
      const vx = (p.x - p.px) * 0.995, vy = (p.y - p.py) * 0.995;
      p.px = p.x; p.py = p.y;
      p.x += vx; p.y += vy + 0.32;
    }
    const tip = pts[N - 1];
    if (drag) { tip.x = mx; tip.y = my; tip.px = tip.x - (mx - tip.x) * 0; }
    for (let it = 0; it < ITER; it++) {
      pts[0].x = anchor.x; pts[0].y = anchor.y;
      for (let i = 0; i < N - 1; i++) {
        const a = pts[i], b = pts[i + 1];
        const dx = b.x - a.x, dy = b.y - a.y, d = Math.hypot(dx, dy) || 1e-4;
        if (d <= seg) continue; // uma via: corda frouxa não empurra
        const k = (d - seg) / d;
        const wa = i === 0 ? 0 : 0.5, wb = drag && i + 1 === N - 1 ? 0 : 1 - wa;
        const tot = wa + wb || 1;
        a.x += dx * k * (wa / tot); a.y += dy * k * (wa / tot);
        b.x -= dx * k * (wb / tot); b.y -= dy * k * (wb / tot);
      }
      if (drag) { tip.x = mx; tip.y = my; }
    }
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    // arco de alcance (gizmo de raio máximo)
    const L = seg * (N - 1);
    ctx.setLineDash([3, 5]); ctx.strokeStyle = col.muted; ctx.globalAlpha = .45; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.arc(anchor.x, anchor.y, L, Math.PI * .08, Math.PI * .92); ctx.stroke();
    ctx.setLineDash([]); ctx.globalAlpha = 1;
    // âncora
    ctx.fillStyle = col.ink; ctx.fillRect(anchor.x - 40, anchor.y - 3, 80, 3);
    for (let i = -36; i <= 36; i += 8) { ctx.beginPath(); ctx.moveTo(anchor.x + i, anchor.y - 3); ctx.lineTo(anchor.x + i - 6, anchor.y - 10); ctx.strokeStyle = col.ink; ctx.stroke(); }
    // corda
    ctx.lineCap = 'round'; ctx.lineJoin = 'round'; ctx.strokeStyle = col.ink; ctx.lineWidth = 2.2;
    ctx.beginPath(); ctx.moveTo(pts[0].x, pts[0].y);
    for (let i = 1; i < N - 1; i++) { const mx2 = (pts[i].x + pts[i + 1].x) / 2, my2 = (pts[i].y + pts[i + 1].y) / 2; ctx.quadraticCurveTo(pts[i].x, pts[i].y, mx2, my2); }
    ctx.lineTo(pts[N - 1].x, pts[N - 1].y); ctx.stroke();
    // nós
    ctx.fillStyle = col.giz;
    for (let i = 1; i < N - 1; i += 2) ctx.fillRect(pts[i].x - 2, pts[i].y - 2, 4, 4);
    // vetor de velocidade
    const t = pts[N - 1];
    const vx = t.x - t.px, vy = t.y - t.py;
    ctx.strokeStyle = col.giz; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(t.x, t.y); ctx.lineTo(t.x + vx * 6, t.y + vy * 6); ctx.stroke();
    // gancho
    const s = pts[N - 3], ang = Math.atan2(t.y - s.y, t.x - s.x);
    ctx.save(); ctx.translate(t.x, t.y); ctx.rotate(ang);
    ctx.strokeStyle = col.red; ctx.fillStyle = col.red; ctx.lineWidth = 3.2; ctx.lineCap = 'round';
    ctx.beginPath(); ctx.moveTo(-2, 0); ctx.lineTo(14, 0); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(14, 0); ctx.quadraticCurveTo(10, -10, 2, -12); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(14, 0); ctx.quadraticCurveTo(10, 10, 2, 12); ctx.stroke();
    ctx.beginPath(); ctx.arc(-3, 0, 4.5, 0, Math.PI * 2); ctx.fill();
    ctx.restore();
    // hud
    if (frame++ % 6 === 0) {
      vOut.textContent = (Math.hypot(vx, vy) * 60 / 40).toFixed(1);
      let len = 0; for (let i = 0; i < N - 1; i++) len += Math.hypot(pts[i + 1].x - pts[i].x, pts[i + 1].y - pts[i].y);
      sOut.textContent = Math.max(0, len / L - 1).toFixed(2);
    }
  }

  function loop() { if (visible) { step(); draw(); } requestAnimationFrame(loop); }

  function pos(e: PointerEvent) { const r = canvas.getBoundingClientRect(); mx = e.clientX - r.left; my = e.clientY - r.top; }
  canvas.addEventListener('pointerdown', (e) => {
    pos(e);
    const t = pts[N - 1];
    if (Math.hypot(mx - t.x, my - t.y) > 60) return;
    drag = true; canvas.setPointerCapture(e.pointerId); canvas.classList.add('dragging'); sim.classList.add('used');
  });
  canvas.addEventListener('pointermove', (e) => { pos(e); if (!drag) { const t = pts[N - 1]; canvas.style.cursor = Math.hypot(mx - t.x, my - t.y) < 60 ? 'grab' : 'default'; } });
  const release = () => { drag = false; canvas.classList.remove('dragging'); };
  canvas.addEventListener('pointerup', release);
  canvas.addEventListener('pointercancel', release);
  new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(canvas);
  new ResizeObserver(() => resize()).observe(canvas);

  resize();
  if (reduce) { for (let i = 0; i < 600; i++) step(); draw(); } else loop();
</script>
